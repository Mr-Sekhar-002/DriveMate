# DriveMate Backend Environment Configuration Template
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL!
# Copy this file to .env and replace placeholders with real keys.

APP_NAME=DriveMate
APP_ENV=development
APP_DEBUG=true

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=drivemate
DB_USER=root
DB_PASS=

# Base URL
BASE_URL=http://localhost/drivemate-api

# JWT Authentication (HS256)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECURE_KEY_MIN_32_CHARS
JWT_EXPIRATION=604800

# Mapping Engine (100% Free OpenStreetMap OSRM + Nominatim)
MAP_PROVIDER=openstreetmap

# Payment Gateway (Razorpay Sandbox/Live)
RAZORPAY_KEY=YOUR_RAZORPAY_KEY
RAZORPAY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# UPI & In-App Payment Configuration
UPI_VPA=drivemate@icici
UPI_PAYEE_NAME="DriveMate Mobility"
CURRENCY=INR

# Real SMS OTP Gateway Configuration (MSG91 / Fast2SMS)
SMS_GATEWAY=auto
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_MSG91_DLT_TEMPLATE_ID
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
